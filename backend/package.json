{
  "name": "personal-ai-assistant-backend",
  "version": "0.1.0",
  "description": "Backend REST API untuk Personal AI Assistant — keuangan, jadwal, pengingat, dan dashboard. Single-user, Express + Supabase.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.2.0",
    "@supabase/supabase-js": "^2.47.0",
    "zod": "^3.23.8",
    "typescript": "~5.6.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.5"
  }
}
